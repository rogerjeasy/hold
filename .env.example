# Copy to .env, which stays out of git. Sandbox only. Live credentials never go in a file.

# REST API credentials of one PayPal sandbox app, from developer.paypal.com > Apps & Credentials > Sandbox.
# The app belongs to a sandbox business account, which stands in for a shop.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# The currency the sandbox trials use. It must be one the sandbox business account accepts.
PAYPAL_TRIAL_CURRENCY=USD

# Claude on Amazon Bedrock, used by the comparison. Either a Bedrock API key, or leave it empty and use the usual
# AWS credential chain (aws login, AWS_PROFILE, or access keys). The region must offer Claude Opus 5.5.
AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=
