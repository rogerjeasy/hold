{
  "name": "hold",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @hold/web dev",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @hold/web test:e2e",
    "lint": "pnpm -r --if-present run typegen && eslint .",
    "typecheck": "tsc --noEmit && pnpm -r --if-present run typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
