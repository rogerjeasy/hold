# Copy to .env.local, which stays out of git. The web app reads these at start-up (packages/config/src/web-config.ts).

# development on your own machine, production when deployed. `test` runs the app against in-process fakes and is
# set only by the end-to-end tests.
HOLD_ENVIRONMENT=development
HOLD_AWS_REGION=us-east-1

# From the HoldIdentity stack's outputs.
HOLD_COGNITO_USER_POOL_ID=
HOLD_COGNITO_CLIENT_ID=
# The secret that seals the sign-in cookie (HoldIdentity output CookieKeySecretArn). On your own machine you may
# instead set HOLD_COOKIE_KEY to 32 random bytes, base64-encoded: openssl rand -base64 32. Deployed, only the secret.
HOLD_COOKIE_KEY_SECRET_ARN=
# The secret renter links are signed with (HoldIdentity output RenterLinkKeySecretArn), which the worker reads too.
# Optional on your own machine, where links fall back to the cookie key, or set HOLD_RENTER_LINK_KEY like the cookie
# key. Deployed, only the secret.
# HOLD_RENTER_LINK_KEY_SECRET_ARN=
# The secret renter keys are made with: a keyed hash of the PayPal payer ID for the Clean Record (HoldIdentity output
# TrustKeySecretArn). Optional on your own machine, where it falls back to the cookie key, or set HOLD_TRUST_KEY like the
# cookie key. Deployed, only the secret.
# HOLD_TRUST_KEY_SECRET_ARN=
# The KMS key that signs Clean Record credentials, by alias (an administrator makes it: infra/lib/settings.ts). Optional
# on your own machine, where a key made at start signs them. Deployed, required.
# HOLD_CREDENTIAL_KEY_ID=alias/hold-credential-key

# The Aurora cluster and the hold_app login's secret, from the HoldData stack. Reached through the RDS Data API.
HOLD_DATABASE_CLUSTER_ARN=
HOLD_DATABASE_SECRET_ARN=
HOLD_DATABASE_NAME=hold_db

# Hold's own emails, such as staff invitations, go through the SMTP account kept in this secret. Links in them point to
# HOLD_PUBLIC_URL.
HOLD_SMTP_SECRET=hold/email/smtp
HOLD_PUBLIC_URL=http://localhost:3210
# Optional locally: send a sealed return to the comparison worker immediately. The outbox relay is the fallback.
# HOLD_COMPARISONS_QUEUE_URL=

# AWS credentials for the account, through the usual chain. Locally, a profile.
AWS_PROFILE=

# The AG Grid Enterprise licence key, for the decision board, the open scorecard and the price list editor. Never commit
# it. Without it the grids work, with a watermark off localhost and AG Grid's notice in the console.
# HOLD_AG_GRID_LICENCE_KEY=
